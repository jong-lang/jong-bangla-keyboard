{
  "app-id": "org.fcitx.Fcitx5.Addon.Jong",
  "branch": "stable",
  "runtime": "org.fcitx.Fcitx5",
  "runtime-version": "stable",
  "sdk": "org.kde.Sdk//6.11",
  "build-extension": true,
  "separate-locales": false,
  "build-options": {
    "prefix": "/app/addons/Jong",
    "prepend-path": "/app/addons/Jong/toolchain/bin",
    "env": {
      "CARGO_NET_OFFLINE": "true",
      "CARGO_HOME": "/run/build/jong/cargo-home"
    }
  },
  "cleanup": ["/toolchain"],
  "modules": [
    {
      "name": "jong-rust",
      "buildsystem": "simple",
      "build-commands": [
        "./install.sh --prefix=${FLATPAK_DEST}/toolchain --disable-ldconfig --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu,rustfmt-preview,clippy-preview"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://static.rust-lang.org/dist/rust-1.99.1-x86_64-unknown-linux-gnu.tar.xz",
          "sha256": "231fcae47ee950621374725b5fc3b5441d2fbda2955ac45dd7dc816d8876cfe7",
          "only-arches": ["x86_64"]
        }
      ]
    },
    {
      "name": "jong",
      "buildsystem": "simple",
      "build-commands": ["bash packaging/flatpak/build.sh"],
      "sources": [
        {"type": "dir", "path": "source"},
        {"type": "file", "path": "source-info.json"}
      ]
    }
  ]
}
