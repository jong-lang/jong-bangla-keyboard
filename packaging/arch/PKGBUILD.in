# Maintained in the Jong Bangla repository. Regenerate .SRCINFO with makepkg.
pkgname=jong-bangla
pkgver=@VERSION@
pkgrel=@REVISION@
pkgdesc='Bangla phonetic input method for Fcitx5'
arch=('x86_64')
url='https://github.com/jong-lang/jong-bangla-keyboard'
license=('MIT' 'BSD-2-Clause' 'Unicode-3.0')
options=('!debug')
depends=('fcitx5>=5.1.23' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('rust>=1:1.99.1' 'cmake>=3.25' 'ninja' 'python')
source=('source.tar.gz::@SOURCE_URL@')
sha256sums=('@SHA256@')

build() {
  cmake -S "@SOURCE_DIR@/adapters/fcitx5" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DFCITX_INSTALL_USE_FCITX_SYS_PATHS=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
  python "@SOURCE_DIR@/tools/check-install.py" build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "@SOURCE_DIR@/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "@SOURCE_DIR@/THIRD_PARTY_NOTICES" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES"
  install -Dm644 "@SOURCE_DIR@/docs/PACKAGING.md" "$pkgdir/usr/share/doc/$pkgname/PACKAGING.md"
  python "@SOURCE_DIR@/tools/copy-rust-notices.py" "$pkgdir/usr/share/licenses/$pkgname/rust-stdlib"
}
