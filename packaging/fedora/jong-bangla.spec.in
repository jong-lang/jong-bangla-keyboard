Name: jong-bangla
Version: @VERSION@
Release: @REVISION@
Summary: Bangla phonetic input method for Fcitx5
License: MIT AND BSD-2-Clause AND Unicode-3.0
URL: https://github.com/jong-lang/jong-bangla-keyboard
Source0: source.tar.gz
ExclusiveArch: x86_64
BuildRequires: gcc-c++, cmake >= 3.25, ninja-build, rust >= 1.99.1, cargo, fcitx5-devel >= 5.1.23, hicolor-icon-theme, python3
Requires: fcitx5 >= 5.1.23
Requires: hicolor-icon-theme

%description
Independent Rust composition engine with an Fcitx5 adapter.
Activation is an explicit desktop configuration step.

%prep
%setup -q -n @SOURCE_DIR@

%build
%cmake -S adapters/fcitx5 -G Ninja -DFCITX_INSTALL_USE_FCITX_SYS_PATHS=ON
%cmake_build

%check
%ctest
python3 tools/check-install.py %{_vpath_builddir}

%install
%cmake_install
python3 tools/copy-rust-notices.py %{buildroot}%{_licensedir}/%{name}/rust-stdlib

%files
%license LICENSE THIRD_PARTY_NOTICES
%{_licensedir}/%{name}/rust-stdlib/
%doc docs/PACKAGING.md
%{_libdir}/fcitx5/libjong-bangla.so
%{_datadir}/fcitx5/addon/jong-bangla.conf
%{_datadir}/fcitx5/inputmethod/jong-bangla.conf
%{_datadir}/icons/hicolor/scalable/apps/jong-bangla.svg
%{_datadir}/icons/hicolor/128x128/apps/jong-bangla.png
%{_datadir}/icons/hicolor/256x256/apps/jong-bangla.png
%{_datadir}/icons/hicolor/512x512/apps/jong-bangla.png
%{_datadir}/icons/hicolor/scalable/status/jong-symbolic.svg
%{_datadir}/icons/hicolor/scalable/status/fcitx-jong-bangla-light.svg
%{_datadir}/icons/hicolor/scalable/status/fcitx-jong-bangla-dark.svg
%{_datadir}/icons/hicolor/24x24/status/fcitx-jong-bangla-light.png
%{_datadir}/icons/hicolor/24x24/status/fcitx-jong-bangla-dark.png
